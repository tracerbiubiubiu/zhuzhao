# Release template: copy to a protected .env and fill every required value.
# Use independent random secrets (for example: openssl rand -hex 32).
# Empty values fail compose interpolation; repo-known dev secrets fail app validation.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
GATEWAY_SK=
TASKRUNNER_SK=
INTERNAL_JOBS_SK=
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=168h
# Optional human audit-maintenance grants: comma-separated stable local user IDs.
# Empty means deny human maintenance. Page/task permissions grant nothing here.
# Invalid or duplicate IDs reject server startup; break-glass loads connections only.
TASK_MAINTAINER_USER_IDS=

RUSTFS_ROOT_USER=zhuzhao_storage
RUSTFS_ROOT_PASSWORD=
RUSTFS_BACKUP_ROOT_USER=zhuzhao_backup
RUSTFS_BACKUP_ROOT_PASSWORD=
# HTTPS browser-facing origin; preserve signed Host through the reverse proxy.
# A local-only isolated drill may use http://127.0.0.1:9000 and cookie_secure=false.
STORAGE_PUBLIC_ENDPOINT=
RUSTFS_CORS_ALLOWED_ORIGINS=
STORAGE_BUCKET=zhuzhao
STORAGE_REGION=us-east-1
STORAGE_FILE_COOKIE_SECURE=true
# Primary S3 is bound to host loopback; console is not published.
RUSTFS_API_PORT=9000
APP_PORT=33333
UI_PORT=48080
