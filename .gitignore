# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Build output
bin/
logs/

# Wire generated (uncomment to ignore, but recommended to commit)
# internal/app/wire_gen.go
.DS_Store

# ai
.opencode
.codebuddy
.workbuddy
.VSCodeCounter
.zcode


# 防复发：vendor 快照曾误入历史（ab6e2f5，GitHub Push Protection 拦截）；构建走 goproxy.cn 无需 vendor
vendor/
deployments/.env

# 审计归档本地卷运行时产物（audit_archive 导出 JSONL，dev/运行期产生，不入库）
data/



# Local Python verification bytecode
__pycache__/
*.py[cod]

# Isolated non-runtime reference validation dependencies
/scripts/reference-tools/node_modules/

# Local-only references and execution artifacts: archive outside this repository.
# Keep legacy paths excluded to prevent accidental copying back; maintained docs stay in docs/.
/doc/
/deliverables/
/outputs/
/audit-reports/
/.codex/
/archives/
/private/
/references/
/evidence/
/maintenance/

# Preserve existing nested legacy workspace exclusions.
doc/
.codex/

# Local secret overrides; keep versioned environment templates visible.
/.env.local
/.env.*.local
